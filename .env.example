# Port the gateway listens on
PORT=8080

# SQLite database file path (will be created if it doesn't exist)
DATABASE_PATH=./data/gateway.db

# Admin REST API auth — required for /admin/* routes.
# Use a long random string. If unset, the /admin/* routes are disabled entirely.
ADMIN_API_KEY=

# Upstream Devin API base URL. Override only for enterprise deployments
# (e.g. https://api.your-company.devinenterprise.com).
DEVIN_API_BASE_URL=https://api.devin.ai

# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Optional: set to "production" to enable Node cluster workers
NODE_ENV=development
