{
  "name": "devin-proxy-gateway",
  "version": "0.2.0",
  "description": "Devin API reverse proxy gateway with multi-tenant proxy keys",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm run build:server && pnpm run build:dashboard",
    "build:server": "node ./build.mjs",
    "build:dashboard": "cd dashboard && pnpm install --prefer-offline --no-frozen-lockfile && pnpm build",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "dev": "tsx watch src/index.ts",
    "dev:dashboard": "cd dashboard && pnpm dev",
    "typecheck": "tsc --noEmit",
    "create-key": "tsx scripts/create-key.ts",
    "list-keys": "tsx scripts/list-keys.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "cors": "^2.8.5",
    "express": "^5.0.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-serve-static-core": "^5.1.1",
    "@types/node": "^22.10.1",
    "esbuild": "0.25.8",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "~5.9.2"
  }
}
